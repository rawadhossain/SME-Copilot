# Local dev only. Synthetic data, no real credentials.
# Owner connection: migrations and chain verification only.
DATABASE_URL=postgres://sme:sme@localhost:5432/sme
# App connection: least-privilege role created by the migration (password set by db:migrate).
APP_DB_PASSWORD=sme_app_dev
APP_DATABASE_URL=postgres://sme_app:sme_app_dev@localhost:5432/sme

# DEV ONLY owner signing keys (Ed25519, base64 DER). Synthetic demo; never use for anything real.
# The private key signs mandates and approvals (src/gate/owner-signing.ts only). Anyone with this file can sign as the owner.
OWNER_SIGNING_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIMHPBo+KcIfFPvF+qEZGB4UwMBnqQ6RL1ZGjx7VErlSY
OWNER_SIGNING_PUBLIC_KEY=MCowBQYDK2VwAyEAqgExJrOTLbCcYjQKCQZXck2rbeVwo4npzMF7OeLA6tI=

# ---- LLM gateway (ADR-012). Provider is UNKNOWN: any OpenAI-compatible endpoint works (hosted or local). ----
# LLM_PROVIDER: openai-compatible | mock  (default mock: scripted responses, no network)
# LLM_BASE_URL: the OpenAI-compatible base URL, e.g. https://<host>/v1   (needed for openai-compatible)
# LLM_API_KEY: your key. Put it ONLY in your local .env (git-ignored). Never commit it. Never paste it into chat.
# LLM_MODEL: the model id your endpoint expects
# LLM_MODE: live | record | replay  (default: replay if fixtures/llm-recordings has recordings, else live)
# LLM_STRUCTURED_OUTPUTS: true if your endpoint supports JSON-schema structured outputs (default false)
LLM_PROVIDER=mock
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_MODE=replay
# LLM_STRUCTURED_OUTPUTS=false

# Proposal and approval lifetime in world-time hours (default 24).
# PROPOSAL_TTL_HOURS=24
