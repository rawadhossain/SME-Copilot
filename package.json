{
  "name": "sme-finance-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env scripts/migrate.ts",
    "db:verify-chain": "bun --env-file=.env scripts/verify-chain.ts",
    "check:money": "bun scripts/money-sanity.ts",
    "db:seed": "bun --env-file=.env scripts/seed-synthetic.ts",
    "db:reset-seed": "bun --env-file=.env scripts/seed-synthetic.ts --reset",
    "import:csv": "bun --env-file=.env scripts/import-csv.ts",
    "check:engine": "bun --env-file=.env scripts/engine-sanity.ts",
    "check:sandbox": "bun --env-file=.env scripts/sandbox-sanity.ts",
    "mandate:keygen": "bun scripts/mandate-keygen.ts",
    "check:gate": "bun --env-file=.env scripts/gate-sanity.ts",
    "db:wipe": "docker compose down -v && bun run db:up && bun run db:migrate && bun run db:seed",
    "llm:smoke": "bun --env-file=.env scripts/llm-smoke.ts",
    "llm:record-scripted": "bun scripts/record-scripted.ts",
    "check:extract": "bun --env-file=.env scripts/extract-sanity.ts",
    "check:agent": "bun --env-file=.env scripts/agent-sanity.ts",
    "check:financing": "bun scripts/financing-sanity.ts",
    "check:plan": "bun --env-file=.env scripts/plan-sanity.ts",
    "check:ledger": "bun --env-file=.env scripts/ledger-sanity.ts",
    "check:funding-decision": "bun --env-file=.env scripts/funding-decision-sanity.ts",
    "check:rescue": "bun --env-file=.env scripts/rescue-sanity.ts",
    "check:insights": "bun --env-file=.env scripts/insights-sanity.ts",
    "test:browser": "bun --env-file=.env scripts/browser-journey.ts",
    "ask:live": "bun --env-file=.env scripts/ask-live.ts",
    "mandate:v2": "bun --env-file=.env scripts/mandate-v2.ts",
    "mandate:funding": "bun --env-file=.env scripts/mandate-funding-limits.ts",
    "auth:seed": "bun --env-file=.env scripts/seed-accounts.ts",
    "e2e:smoke": "bun --env-file=.env scripts/e2e-smoke.ts",
    "demo": "bun --env-file=.env scripts/demo-server.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.68",
    "ai": "^7.0.140",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
